# Copy to .env on the VPS and fill in. Never commit .env.

# ---- Domain (Caddy gets the HTTPS certificate automatically) ----
SITE_DOMAIN=simlabkenya.co.ke
SITE_ADDRESS=simlabkenya.co.ke
ALLOWED_ORIGINS=https://simlabkenya.co.ke,https://www.simlabkenya.co.ke

# ---- Postgres (Ocean Shujaa registrations) ----
POSTGRES_DB=simlab
POSTGRES_USER=simlab
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---- Admin login (lives on the VPS, in Postgres) ----
# Random string, 32+ chars. Changing it signs every admin out.
JWT_SECRET=
# Used only by start-setup.sh to create the first admin (the script prompts if empty).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Supabase (still holds shop products + orders; admin login no longer uses it) ----
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email (Gmail app password) ----
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=
ADMIN_DASHBOARD_URL=https://simlabkenya.co.ke/admin

# ---- Firebase admin (abstracts). Keep the private key on ONE line with literal \n ----
VITE_FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Cloudinary (abstract file uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
